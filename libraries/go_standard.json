{
  "id": "go_standard",
  "version": "1.0.0",
  "types": [
    "any",
    "bool",
    "byte",
    "comparable",
    "complex64",
    "complex128",
    "error",
    "float32",
    "float64",
    "int",
    "int8",
    "int16",
    "int32",
    "int64",
    "rune",
    "string",
    "uint",
    "uint8",
    "uint16",
    "uint32",
    "uint64",
    "uintptr"
  ],
  "funcs": {
    "append": {
      "added": 0.0,
      "arguments": [
        ["slice", "[]Type"],
        ["elems", "...Type"]
      ],
      "returns": "[]Type"
    },
    "cap": {
      "added": 0.0,
      "arguments": [["v", "Type"]],
      "returns": "int"
    },
    "clear": {
      "added": 1.21,
      "types": [{ "T": "~[]Type | ~map[Type]Type1" }],
      "arguments": [["t", "T"]],
      "returns": null
    },
    "close": {
      "added": 0.0,
      "arguments": [["c", "chan<- Type"]],
      "returns": null
    },
    "complex": {
      "added": 0.0,
      "arguments": [
        ["r", "FloatType"],
        ["i", "FloatType"]
      ],
      "returns": "ComplexType"
    },
    "copy": {
      "added": 0.0,
      "arguments": [
        ["dst", "[]Type"],
        ["src", "[]Type"]
      ],
      "returns": "int"
    },
    "delete": {
      "added": 0.0,
      "arguments": [
        ["m", "map[Type]Type1"],
        ["key", "Type"]
      ],
      "returns": null
    },
    "imag": {
      "added": 0.0,
      "arguments": [["c", "ComplexType"]],
      "returns": "FloatType"
    },
    "len": {
      "added": 0.0,
      "arguments": [["v", "Type"]],
      "returns": "int"
    },
    "make": {
      "added": 0.0,
      "arguments": [
        ["t", "Type"],
        ["size", "...IntegerType"]
      ],
      "returns": "Type"
    },
    "max": {
      "added": 1.21,
      "types": [{ "T": "cmp.Ordered" }],
      "arguments": [
        ["x", "T"],
        ["y", "...T"]
      ],
      "returns": "T"
    },
    "min": {
      "added": 1.21,
      "types": [{ "T": "cmp.Ordered" }],
      "arguments": [
        ["x", "T"],
        ["y", "...T"]
      ],
      "returns": "T"
    },
    "new": {
      "added": 0.0,
      "arguments": [["t", "Type"]],
      "returns": "*Type"
    },
    "panic": {
      "added": 0.0,
      "arguments": [["v", "any"]],
      "returns": null
    },
    "print": {
      "added": 0.0,
      "arguments": [["args", "...Type"]],
      "returns": null
    },
    "println": {
      "added": 0.0,
      "arguments": [["args", "...Type"]],
      "returns": null
    },
    "real": {
      "added": 0.0,
      "arguments": [["c", "ComplexType"]],
      "returns": "FloatType"
    },
    "recover": {
      "added": 0.0,
      "returns": "any"
    }
  }
}
