---
import Layout from "../layouts/Layout.astro";
---

<Layout title="opticode">
  <main>
    <script>
      import * as runtime from "../../wailsjs/runtime/runtime";
      import * as app from "../../wailsjs/go/desktop/App";
      import * as tree from "../../wailsjs/go/tree/Tree";

      document.addEventListener("DOMContentLoaded", function () {
        const button = document.getElementById("test");
        if (button) {
          button.addEventListener("click", test);
        }
      });

      async function test() {
        runtime.LogDebug("click test button");
        await tree.OpenFile("exampleTreeData.json");

        try {
          await app.GenerateCode("./output");
        } catch (err) {
          runtime.LogError(String(err));
        }
      }
    </script>
    <button id="test">TEST ME</button>
  </main>
</Layout>

<style>
  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem;
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 2rem;
    text-align: center;
  }
</style>
