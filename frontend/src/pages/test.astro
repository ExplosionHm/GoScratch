<head>
  <meta charset="UTF-8" />
  <title>Opticode UI</title>
</head>
<body>
  <div class="layout">
    <div class="icon-strip">
      <button id="test"></button>
      <button></button>
      <button></button>
      <button></button>
      <div class="spacer"></div>
      <button><img src="/images/cog.svg" alt="none" draggable="false" /></button
      >
    </div>

    <div id="sidebar" class="sidebar">
      <div class="card card-cyan">
        Go Standard
        <p>
          The Go standard library is a built-in set of packages that provide
          essential tools for I/O, networking, text processing, and concurrency,
          making Go powerful and efficient without external dependencies.
        </p>
      </div>
      <div class="card card-blue">
        gin
        <p>
          Gin is a high-performance HTTP web framework. Gin is designed for
          building REST APIs, web applications, and microservices where speed
          and developer productivity are essential.
        </p>
      </div>
      <div class="card card-purple"></div>
      <div class="card card-pink"></div>
      <div class="card card-red"></div>
    </div>

    <div class="main">
      <div class="top-bar">
        <button></button>
        <button></button>
        <button></button>
        <button></button>
        <button></button>
        <div class="close"></div>
      </div>

      <div class="editor"></div>
    </div>
  </div>
</body>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    height: 100%;
    font-family: sans-serif;
  }

  body {
    background: #f2f2f2;
  }

  .layout {
    display: flex;
    height: 100vh;
    width: 100vw;
  }

  .icon-strip {
    display: flex;
    user-select: none;
    flex-direction: column;
    align-items: center;
    background: #e0e0e0;
    padding: 8px 4px;
  }

  .icon-strip button {
    width: 32px;
    height: 32px;
    background: #fff;
    border: 1px solid #bbb;
    border-radius: 4px;
    margin: 6px 0;
    cursor: pointer;
  }

  .icon-strip button:hover {
    background: #f1f1f1;
  }

  .icon-strip button:active {
    background: #dfdede;
  }

  .icon-strip img {
    display: block;
    margin-left: auto;
    margin-right: auto;
    width: 95%;
  }

  .icon-strip .spacer {
    flex-grow: 1;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: #f9f9f9;
    padding: 12px;
    border-right: 1px solid #ccc;
    width: 240px;
    overflow-y: auto;

    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
    transform: translateX(0);
    opacity: 1;
  }

  .sidebar.hidden {
    transform: translateX(-100%);
    opacity: 0;
    visibility: hidden;
  }

  .card {
    height: 100px;
    border-radius: 6px;
    border: 1px solid #bbb;
    margin: 0;
    top: 0;
    padding-top: 1px;
    padding: 10px;
    font-size: 24px;
    font-weight: bold;
    text-justify: auto;
    user-select: none;
  }

  .card:hover {
    scale: 1.01;
    transition: 200ms;
  }

  .card:active {
    scale: 1;
    transition: 100ms;
  }

  .card p {
    font-size: 10px;
    font-weight: 200;
    color: #3b3b3b;
    padding: 0;
    text-justify: auto;
  }

  .card-cyan {
    color: #17a3ad;
    background: #d6f0f2;
  }
  .card-blue {
    color: #6d88b4;
    background: #d6e6ff;
  }
  .card-purple {
    background: #e5d6ff;
  }
  .card-pink {
    background: #ffd6eb;
  }
  .card-red {
    background: #ffd6d6;
  }

  /* Main content */
  .main {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    background: #d1d1d1;
  }

  /* Top bar */
  .top-bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    padding: 4px 8px;
    background: #f5f5f5;
    border-bottom: 1px solid #ccc;
  }

  .top-bar button {
    width: 50px;
    height: 20px;
    background: #fff;
    border: 1px solid #bbb;
    border-radius: 4px;
    cursor: pointer;
  }

  .top-bar .close {
    width: 20px;
    height: 20px;
    background: #ff6b6b;
    border: 1px solid #a33;
    border-radius: 50%;
    cursor: pointer;
  }

  /* Coding area */
  .editor {
    flex-grow: 1;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const test = document.getElementById("test");
    if (test) {
      test.addEventListener("click", Test);
    }
  });

  function Test() {
    const sidebar = document.getElementById("sidebar");
    sidebar?.classList.toggle("hidden");
  }
</script>
